{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "列表布局插件 layout config",
  "type": "object",
  "required": ["schemaVersion", "props", "assetRefs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "props": {
      "type": "object",
      "required": [
        "sortMode",
        "rowDensity",
        "coverSize",
        "visibleFields",
        "groupMode",
        "pageSize",
        "background",
        "topRegion"
      ],
      "additionalProperties": false,
      "properties": {
        "sortMode": {
          "type": "string",
          "enum": ["manual", "name-asc", "name-desc"]
        },
        "rowDensity": {
          "type": "string",
          "enum": ["compact", "comfortable", "spacious"]
        },
        "coverSize": {
          "type": "string",
          "enum": ["compact", "regular", "large"]
        },
        "visibleFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["createdAt", "summary", "tags", "type"]
          }
        },
        "groupMode": {
          "type": "string",
          "enum": ["none", "type", "tag"]
        },
        "pageSize": {
          "type": "integer",
          "minimum": 20,
          "maximum": 240
        },
        "background": {
          "$ref": "#/$defs/frameRegion"
        },
        "topRegion": {
          "$ref": "#/$defs/frameRegion"
        }
      }
    },
    "assetRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "frameRegion": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "image"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["assetPath"]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "html"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["html"]
          }
        }
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "image", "html"]
        },
        "assetPath": {
          "type": "string"
        },
        "html": {
          "type": "string"
        }
      }
    }
  }
}
