{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": [
        "src/*"
      ]
    },
    "types": [
      "vitest"
    ]
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "归档",
    "src/**/归档"
  ]
}

