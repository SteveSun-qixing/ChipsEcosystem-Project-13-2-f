      "type": "string"
    },
    "versionId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "renderStatus": {
      "type": "string"
    },
    "renderStatusUrl": {
      "type": "string"
    },
    "communityUrl": {
      "type": "string"
    },
    "networkCardPath": {
