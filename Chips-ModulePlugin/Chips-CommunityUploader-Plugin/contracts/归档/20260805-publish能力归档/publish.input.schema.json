{
  "type": "object",
  "required": ["cardFile", "server"],
  "properties": {
    "cardFile": {
      "type": "string"
    },
    "server": {
      "type": "object",
      "required": ["baseUrl", "accessToken"],
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "accessToken": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"]
        },
        "idempotencyKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "tempDir": {
          "type": "string"
        },
        "keepProcessedCard": {
          "type": "boolean"
        },
        "processedCardPath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
