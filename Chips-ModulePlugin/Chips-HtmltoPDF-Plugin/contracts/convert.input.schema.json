{
  "type": "object",
  "required": ["htmlDir", "outputFile"],
  "properties": {
    "htmlDir": {
      "type": "string"
    },
    "entryFile": {
      "type": "string"
    },
    "outputFile": {
      "type": "string"
    },
    "overwrite": {
      "type": "boolean"
    },
    "options": {
      "type": "object",
      "properties": {
        "pageSize": {
          "type": "string",
          "enum": ["A4", "A3", "Letter", "Legal"]
        },
        "landscape": {
          "type": "boolean"
        },
        "printBackground": {
          "type": "boolean"
        },
        "preferCSSPageSize": {
          "type": "boolean"
        },
        "marginMm": {
          "type": "object",
          "properties": {
            "top": { "type": "number" },
            "right": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" }
          },
          "additionalProperties": false
        },
        "headerFooter": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "headerTemplate": { "type": "string" },
            "footerTemplate": { "type": "string" }
          },
          "additionalProperties": false
        },
        "wait": {
          "type": "object",
          "properties": {
            "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "quietMs": { "type": "number", "exclusiveMinimum": 0 },
            "resourceTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "compositeTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "waitForFonts": { "type": "boolean" },
            "waitForImages": { "type": "boolean" },
            "waitForFrames": { "type": "boolean" },
            "waitForCompositeReady": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
