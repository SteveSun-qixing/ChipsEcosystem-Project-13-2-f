{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IconMakerGenerateInput",
  "type": "object",
  "required": ["inputPath", "outputDir", "formats", "size"],
  "properties": {
    "inputPath": {
      "type": "string"
    },
    "outputDir": {
      "type": "string"
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["png", "ico", "icns"]
      }
    },
    "size": {
      "type": "integer",
      "minimum": 16,
      "maximum": 1024
    }
  },
  "additionalProperties": false
}
