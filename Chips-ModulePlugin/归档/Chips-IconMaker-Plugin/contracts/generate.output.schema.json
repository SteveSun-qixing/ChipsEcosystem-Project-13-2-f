{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IconMakerGenerateOutput",
  "type": "object",
  "required": ["inputPath", "outputDir", "size", "formats", "files"],
  "properties": {
    "inputPath": {
      "type": "string"
    },
    "outputDir": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 16,
      "maximum": 1024
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["png", "ico", "icns"]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
