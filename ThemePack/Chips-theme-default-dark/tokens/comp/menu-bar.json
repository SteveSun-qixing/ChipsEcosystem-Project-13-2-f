{
  "chips": {
    "comp": {
      "menu-bar": {
        "root": {
          "surface": "{chips.sys.color.surface-raised}"
        },
        "menu": {
          "surface": {
            "idle": "transparent",
            "hover": "{chips.sys.color.surface-elevated}"
          }
        },
        "item": {
          "surface": {
            "hover": "{chips.sys.color.info-surface}"
          },
          "text": {
            "color": "{chips.sys.color.on-surface}"
          }
        },
        "shortcut": {
          "color": "{chips.sys.color.on-surface-soft}"
        },
        "focus": {
          "outline": "{chips.sys.color.focus-ring}"
        }
      }
    }
  }
}
